# NexusCRM server configuration.
# Copy to .env and fill in real values. Never commit a real .env.
# (On Vercel, set these same variables in the project dashboard instead.)

# Port the API listens on
PORT=4000

# JWT signing secret — set a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
# Token lifetime, e.g. 8h, 24h, 7d
JWT_EXPIRES_IN=8h

# --- Database (Turso / libSQL) ---
# Remote (production / Vercel): set both and the app uses Turso.
#   TURSO_DATABASE_URL=libsql://<your-db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create <db>`>
# Local dev: leave both unset and the app uses a local libSQL file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local database file (used only when TURSO_DATABASE_URL is unset)
DB_PATH=./data/nexuscrm.db

# --- Upload storage ---
# Optional. When set, document uploads go to Vercel Blob (public URLs).
# When unset, file bytes are stored in the database (5 MB cap per file).
# Create a Blob store in the Vercel dashboard to get a token.
BLOB_READ_WRITE_TOKEN=

# --- AI provider (bring-your-own-key, OpenAI-compatible) ---
# Base URL of the provider, e.g. https://api.openai.com/v1
AI_PROVIDER_URL=https://api.openai.com/v1
# Provider API key. An admin-set key in the DB overrides this.
AI_API_KEY=
# Default model
AI_MODEL=gpt-4o-mini

# --- WhatsApp Cloud API (Meta) ---
# Phone number ID from the Meta developer dashboard
WHATSAPP_PHONE_NUMBER_ID=
# Permanent system-user access token
WHATSAPP_TOKEN=
# Verify token you invent; must match the one entered in the Meta dashboard
WHATSAPP_VERIFY_TOKEN=
